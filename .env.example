# Supabase Configuration (Required for authentication)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Force Demo Mode (optional - set to true to always use demo mode)
VITE_FORCE_DEMO_MODE=false

# Project Setup Information
VITE_PROJECT_STATUS=development
VITE_PROJECT_ID=skillarena

# Stripe Configuration (Required for payment processing)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# AI Feature Configuration (Optional - will run in demo mode if missing)
# OpenAI Configuration
VITE_OPENAI_API_KEY=your_openai_api_key

# Tavus Configuration (Video AI)
VITE_TAVUS_API_KEY=your_tavus_api_key

# ElevenLabs Configuration (Voice AI)
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Network Configuration
# Uncomment this to enable network error simulation for testing
# VITE_SIMULATE_NETWORK_ISSUES=true

# Demo Mode
# Set to true to force demo mode regardless of API keys
# VITE_FORCE_DEMO_MODE=true